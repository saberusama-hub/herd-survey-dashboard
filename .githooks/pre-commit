#!/usr/bin/env bash
#
# Pre-commit hook: catch biome + typecheck regressions before they hit CI.
#
# Why: the project accrued a chronic 19-error biome backlog because CI lint
# failures don't block local commits. This hook closes that gap.
#
# Opt in (one-time, per clone):
#     git config core.hooksPath .githooks
#
# Bypass for a single commit (emergencies, docs-only force, etc.):
#     git commit --no-verify
#
# Skips itself if no JS/TS/JSON/YAML files are staged (docs/data-only commits
# don't need either gate).

# Apple Silicon edge case: some Homebrew-installed git binaries run under
# Rosetta (x86), which makes child Node processes report process.arch="x64"
# even on arm64 hardware — and biome's native binary is platform-specific
# (only @biomejs/cli-darwin-arm64 is installed in node_modules). Detect via
# sysctl.proc_translated (returns 1 when current process is x86-under-Rosetta
# on Apple Silicon) and re-exec under arm64 to match the install.
if [ -z "${PRE_COMMIT_ARCH_REEXEC:-}" ] && command -v arch >/dev/null 2>&1; then
  HW_ARCH=$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)
  PROC_TRANSLATED=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
  if [ "$HW_ARCH" = "1" ] && [ "$PROC_TRANSLATED" = "1" ]; then
    export PRE_COMMIT_ARCH_REEXEC=1
    exec arch -arm64 bash "$0" "$@"
  fi
fi

set -e

# Only consider files staged for commit (not the working tree).
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED" ]; then
  exit 0
fi

# Heuristic: only run when something type-checkable / lintable changed.
NEEDS_CHECK=$(echo "$STAGED" | grep -E '\.(ts|tsx|js|jsx|json|yaml|yml)$|biome\.json' || true)

if [ -z "$NEEDS_CHECK" ]; then
  exit 0
fi

echo "[pre-commit] staged JS/TS/config changes — running gates ($(node -v 2>/dev/null) $(node -p 'process.arch' 2>/dev/null))"

# biome lint: fast (<200ms), strict, formatter-aware
echo "[pre-commit] pnpm lint"
if ! pnpm --silent lint > /tmp/precommit-lint.log 2>&1; then
  echo "[pre-commit] ✗ lint failed:"
  tail -20 /tmp/precommit-lint.log
  echo ""
  echo "[pre-commit] fix: pnpm --filter @herd/web lint:fix"
  echo "[pre-commit] bypass: git commit --no-verify"
  exit 1
fi
echo "[pre-commit] ✓ lint"

# tsc --noEmit: ~3-5s
WEB_CHANGED=$(echo "$STAGED" | grep -E '^apps/web/' || true)
if [ -n "$WEB_CHANGED" ]; then
  echo "[pre-commit] pnpm typecheck"
  if ! pnpm --silent typecheck > /tmp/precommit-tsc.log 2>&1; then
    echo "[pre-commit] ✗ typecheck failed:"
    tail -30 /tmp/precommit-tsc.log
    echo ""
    echo "[pre-commit] bypass: git commit --no-verify"
    exit 1
  fi
  echo "[pre-commit] ✓ typecheck"
fi

exit 0
