{
  "name": "herd-survey-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Research Data Platform — federal R&D funding to U.S. universities (FY2005–FY2024).",
  "license": "MIT",
  "author": "Policy and Strategy team",
  "scripts": {
    "dev": "pnpm --filter @herd/web dev",
    "build": "pnpm --filter @herd/web build",
    "lint": "pnpm --filter @herd/web lint",
    "typecheck": "pnpm --filter @herd/web typecheck",
    "test": "pnpm --filter @herd/web test",
    "data:build": "python3 scripts/build_data.py",
    "data:verify": "python3 scripts/verify_data.py",
    "data:agg": "bash scripts/aggregations/run_all.sh",
    "data:manifest": "/private/tmp/herd_venv/bin/python scripts/refresh_manifest.py",
    "qa:facts": "/private/tmp/herd_venv/bin/python scripts/qa/verify_facts.py",
    "qa:probe": "node scripts/qa/probe_pages.js",
    "qa:axe": "node scripts/qa/axe_smoke.js",
    "qa:links": "node scripts/qa/check_links.js",
    "qa:lighthouse": "node scripts/qa/lighthouse_ci.js",
    "qa:cross": "node scripts/qa/cross_browser.js",
    "qa:all": "bash scripts/qa/run_all.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "devDependencies": {
    "puppeteer-core": "^25.1.0"
  }
}
